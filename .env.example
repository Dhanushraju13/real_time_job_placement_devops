# ==============================================================================
# PlacementHub Environment Configuration
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=placement
POSTGRES_USER=placement
POSTGRES_PASSWORD=placement
DATABASE_URL=postgresql+psycopg://placement:placement@db:5432/placement

# JWT Authentication
JWT_SECRET_KEY=placement_super_secret_jwt_key_2026_devops_platform_secure_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin User Credentials (Created on first startup if no admin exists)
INITIAL_ADMIN_NAME=System Admin
INITIAL_ADMIN_EMAIL=admin@placement.edu
INITIAL_ADMIN_PASSWORD=Admin@123
